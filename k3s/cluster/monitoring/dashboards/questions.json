          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "자주 나온 질문",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,

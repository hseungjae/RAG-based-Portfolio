      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT question AS \"질문\", count(*) AS \"횟수\" FROM chat_log WHERE $__timeFilter(created_at) GROUP BY question ORDER BY 2 DESC, max(created_at) DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "답변 근거로 자주 쓰인 섹션",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s->>'title' AS \"섹션\", count(*) AS \"횟수\", round(avg((s->>'score')::numeric), 2) AS \"평균 점수\" FROM chat_log, jsonb_array_elements(sources) AS s WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "답변하지 못한 질문 (문서 보강 후보)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT max(created_at) AS \"마지막\", question AS \"질문\", count(*) AS \"횟수\", CASE WHEN bool_or(status = 'unanswered') THEN '거절 문장으로 답함' ELSE '근거 점수 낮음' END AS \"이유\" FROM chat_log c WHERE $__timeFilter(created_at) AND (status = 'unanswered' OR (SELECT max((s->>'score')::numeric) FROM jsonb_array_elements(c.sources) AS s) < 0.5) GROUP BY question ORDER BY 1 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "문서에 정보가 없어 거절 문장으로 답했거나, 가장 비슷한 섹션의 검색 점수(코사인 유사도 + 제목 일치 가산점)도 0.5 미만인 질문. 자기소개 문서에 관련 내용을 추가하면 답변이 좋아진다"
    },
    {
      "id": 10,
      "type": "table",
      "title": "실패한 질문",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT created_at AS \"시간\", question AS \"질문\", error AS \"오류\" FROM chat_log WHERE $__timeFilter(created_at) AND status = 'error' ORDER BY created_at DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "최근 질문",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT created_at AS \"시간\", question AS \"질문\", CASE status WHEN 'ok' THEN '정상' WHEN 'unanswered' THEN '답변 못 함' WHEN 'error' THEN '실패' ELSE '중간 취소' END AS \"결과\", answer AS \"답변\", history_turns AS \"이전 대화\", round(first_token_ms / 1000.0, 1) AS \"첫 응답(초)\", round(duration_ms / 1000.0, 1) AS \"전체(초)\", answer_chars AS \"답변 글자\" FROM chat_log WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}

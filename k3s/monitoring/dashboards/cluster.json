        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          },
          "expr": "sort_desc(sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[24h])))",
          "legendFormat": "",
